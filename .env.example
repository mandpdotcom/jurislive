# Stream credentials (server-side only). Get these from https://dashboard.getstream.io
STREAM_API_KEY=
STREAM_API_SECRET=

# Persistence (libSQL / Turso).
# Leave BOTH unset for local dev — the app falls back to a local SQLite file at data/vinylstream.db.
# For a hosted deploy (e.g. Vercel), set these to a Turso database — https://turso.tech
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret for the scheduled sandbox-cleanup cron (app/api/cron/cleanup).
# Set this in production; Vercel Cron sends it as a Bearer token. Leave unset locally to skip
# the auth check. Generate one with: openssl rand -hex 32
CRON_SECRET=
