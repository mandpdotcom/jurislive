# JURISLIVE reste TOUJOURS une démonstration. Aucun interrupteur de vente réelle.
# Valeurs à renseigner uniquement dans Vercel > Settings > Environment Variables > Preview.
# Ne jamais committer ni partager les valeurs.
STREAM_API_KEY=
STREAM_API_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Développement local seulement. Interdit automatiquement sur Vercel.
# Sans Turso, le développement utilise file:data/jurislive.db.
# JURISLIVE_LOCAL_DB=file:data/jurislive.db

# Protection du déploiement : activer Vercel Authentication pour les Preview.
# Aucun CRON de suppression : les journaux de démonstration ne sont pas effacés automatiquement.
